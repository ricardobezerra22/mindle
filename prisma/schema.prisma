generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Mood {
  HAPPY
  CALMLY
  OK
  SAD
  TIRED
  OVERWHELMED
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum GoalStatus {
  IN_PROGRESS
  DONE
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String  @unique
  password String?
  googleId String?
  avatar   String?

  isActive           Boolean? @default(false)
  welcomeEmailSent   Boolean  @default(false)
  emailNotifications Boolean  @default(true)
  createdAt          DateTime @default(now())

  tasks          Task[]
  taskCategories TaskCategory[]
  planner        PlannerEntry[]
  habits         Habit[]
  habitLogs      HabitLog[]
  focusSessions  FocusSession[]
  finances       FinanceEntry[]
  dailyMoods       DailyMood[]
  preferences      UserPreferences?
  projects         Project[]
  goals            Goal[]
  supportTickets   SupportTicket[]
}

model TaskCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  color     String
  createdAt DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  tasks    Task[]
  projects Project[]
}

model Goal {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  color       String?
  status      GoalStatus @default(IN_PROGRESS)
  deadline    DateTime?
  position    Int        @default(0)
  archived    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  projects Project[]
}

model Project {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  archived    Boolean   @default(false)
  archivedAt  DateTime?
  position    Int       @default(0)
  weight      Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId String?       @db.ObjectId
  category   TaskCategory? @relation(fields: [categoryId], references: [id])

  goalId String? @db.ObjectId
  goal   Goal?   @relation(fields: [goalId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  topics Topic[]
  tasks  ProjectTask[]
}

model Topic {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   Json?
  expanded  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  subtopics Subtopic[]
  tasks      ProjectTask[]
}

model Subtopic {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   Json?
  expanded  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topicId String @db.ObjectId
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  tasks ProjectTask[]
}

model ProjectTask {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  projectId  String?  @db.ObjectId
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  topicId    String?  @db.ObjectId
  topic      Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  subtopicId String?  @db.ObjectId
  subtopic   Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
}

model Task {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      TaskStatus @default(NOT_STARTED)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  color       String?
  isFavorite  Boolean    @default(false)
  position    Int        @default(0)
  createdAt   DateTime   @default(now())

  categoryId String?       @db.ObjectId
  category   TaskCategory? @relation(fields: [categoryId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  timeSpent Int @default(0)

  subTasks      SubTask[]
  planner       PlannerEntry[]
  focusSessions FocusSession[]
}

model SubTask {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  title String
  done  Boolean @default(false)

  taskId String @db.ObjectId
  task   Task   @relation(fields: [taskId], references: [id])
}

model PlannerEntry {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  date     DateTime
  position Int      @default(0)

  taskId String @db.ObjectId
  task   Task   @relation(fields: [taskId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

model FocusSession {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  duration     Int // minutos
  elapsed      Int // minutos
  focusContext String?
  date         DateTime @default(now())

  taskId String? @db.ObjectId
  task   Task?   @relation(fields: [taskId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

model Habit {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  icon       String?
  weeklyGoal Int      @default(3)
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  logs HabitLog[]
}

model HabitLog {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  date DateTime @default(now())
  done Boolean  @default(false)

  habitId String @db.ObjectId
  habit   Habit  @relation(fields: [habitId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

model DailyMood {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime     @default(now())
  mood        Mood
  energy      EnergyLevel?
  createdAt   DateTime     @default(now())

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

model UserPreferences {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  focusDuration   String  @default("30")
  autoBreak       Boolean @default(false)
  focusSound      Boolean @default(true)
  weekStart       String  @default("monday")
  showOnlyToday   Boolean @default(false)
  showCompleted   Boolean @default(true)
  dailyReminder   Boolean @default(false)
  showInsights    Boolean @default(true)
  financeReminder Boolean @default(true)
  autoArchivePaid Boolean @default(false)
  theme           String  @default("light")
  reducedMotion   Boolean @default(false)
  fontSize        String  @default("normal")

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  from        String
  subject     String
  text        String?
  html        String?
  attachments Json[]
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])
}

enum FinanceStatus {
  NOT_STARTED
  PENDING
  PAID
}

model FinanceEntry {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  category  String?
  amount    Float
  status    FinanceStatus @default(NOT_STARTED)
  dueDate   DateTime?
  note      String?
  archived  Boolean       @default(false)
  createdAt DateTime      @default(now())
  paidAt    DateTime?

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}
