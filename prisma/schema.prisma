generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String  @unique
  password String?
  googleId String?
  avatar   String?

  isActive  Boolean? @default(false)
  createdAt DateTime @default(now())

  tasks          Task[]
  taskCategories TaskCategory[]
  planner        PlannerEntry[]
  habits         Habit[]
  habitLogs      HabitLog[]
  focusSessions  FocusSession[]
  finances       FinanceEntry[]
  dailyMoods     DailyMood[]
  preferences    UserPreferences?
}

model TaskCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  color     String
  createdAt DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  tasks Task[]
}

model Task {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      TaskStatus @default(NOT_STARTED)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  color       String?
  createdAt   DateTime   @default(now())

  categoryId String?       @db.ObjectId
  category   TaskCategory? @relation(fields: [categoryId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  subTasks SubTask[]
  planner  PlannerEntry[]
}

model SubTask {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  title String
  done  Boolean @default(false)

  taskId String @db.ObjectId
  task   Task   @relation(fields: [taskId], references: [id])
}

model PlannerEntry {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  date DateTime

  taskId String @db.ObjectId
  task   Task   @relation(fields: [taskId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

model FocusSession {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  duration     Int // minutos
  elapsed      Int // minutos
  focusContext String?
  date         DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

model Habit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  icon      String?
  createdAt DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  logs HabitLog[]
}

model HabitLog {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  date DateTime @default(now())
  done Boolean  @default(false)

  habitId String @db.ObjectId
  habit   Habit  @relation(fields: [habitId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

model DailyMood {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime @default(now())
  mood      String
  createdAt DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

model UserPreferences {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  focusDuration   String  @default("30")
  autoBreak       Boolean @default(false)
  focusSound      Boolean @default(true)
  weekStart       String  @default("monday")
  showOnlyToday   Boolean @default(false)
  showCompleted   Boolean @default(true)
  dailyReminder   Boolean @default(false)
  showInsights    Boolean @default(true)
  financeReminder Boolean @default(true)
  autoArchivePaid Boolean @default(false)
  theme           String  @default("light")
  reducedMotion   Boolean @default(false)
  fontSize        String  @default("normal")

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

enum FinanceStatus {
  NOT_STARTED
  PENDING
  PAID
}

model FinanceEntry {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  category  String?
  amount    Float
  status    FinanceStatus @default(NOT_STARTED)
  dueDate   DateTime?
  note      String?
  archived  Boolean       @default(false)
  createdAt DateTime      @default(now())
  paidAt    DateTime?

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}
